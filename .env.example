# Copy to .env and fill in. NEVER commit .env. Values here must stay empty.
# Used by apps/api (server side only).
# The admin app has its own apps/admin/.env.example with VITE_ keys only.

# ---- App ----
# local | staging | production
APP_ENV=
# Random string for signing app-level tokens (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
# true = local demo routes at /demo and `make demo-reset` (docs/DEMO.md). Localhost only:
# never with a tunnel, never on a shared host.
DEMO_MODE=

# ---- Supabase ----
# Local: printed by `supabase start` (http://127.0.0.1:54321)
SUPABASE_URL=
# Public anon key. Safe in the browser only because RLS is on for every table.
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never put this in apps/admin or any VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string. Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=
# Legacy HS256 JWT secret used to verify owner tokens (projects on asymmetric keys use JWKS instead)
SUPABASE_JWT_SECRET=

# ---- Sarvam Voice Agents (docs/SARVAM_AGENT.md) ----
# Voice Agents workspace API key (Voice Agents dashboard: Settings -> API Key), sent as X-API-Key.
# Used for instant outbound calls and the Analytics API. Not the Model API key (unused here).
# Paid: calls placed with it spend credits. Server side only.
SARVAM_VOICE_API_KEY=
# Settings -> Organisation -> General (copy button)
SARVAM_ORG_ID=
# Settings -> Workspace -> General (copy button)
SARVAM_WORKSPACE_ID=
# Agent ID (agent menu -> Copy agent ID) and the committed version used for outbound calls
SARVAM_APP_ID=
SARVAM_APP_VERSION=
# Telephony connection and the agent's number (E.164) used for outbound calls
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
# Bearer token the Sarvam agent sends to our API tools and hooks. Store the same value in
# Sarvam's Settings -> Secrets. python -c "import secrets; print(secrets.token_urlsafe(48))"
VOICE_TOOL_SECRET=
# Path token for Sarvam's call-completion webhooks (they cannot send auth headers). Same command.
VOICE_WEBHOOK_SECRET=
# Optional comma-separated source IPs allowed on the voice endpoints. Empty = any.
# Sarvam documents 4.213.167.70 and 35.154.84.150 for tool calls (re-check before enabling).
VOICE_IP_ALLOWLIST=
# true | false (default false). false = dry run: outbound calls are logged, never placed.
# Do not set true without the owner's go (docs/DECISIONS.md).
OUTBOUND_CALLS_ENABLED=
# Public HTTPS base of this API (the webhook URL sent with outbound calls), e.g. the tunnel URL
PUBLIC_BASE_URL=

# ---- Spend guard (Sarvam credits, docs/COSTS.md) ----
# Rupees. Outbound calls and test runs we start are blocked once a cap would be passed.
# Defaults: 100 per session, 500 per IST day.
SPEND_SESSION_CAP_INR=
SPEND_DAILY_CAP_INR=
# Optional label for a test session; default = one session per API process.
SPEND_SESSION_ID=

# ---- Client intake (docs/INTAKE_CONTRACT.md) ----
# hmac_webhook (default)
INTAKE_ADAPTER=
# Shared secret for signing intake requests, >= 32 chars. Share it with the registration form's
# owner over a secure channel. python -c "import secrets; print(secrets.token_urlsafe(48))"
INTAKE_HMAC_SECRET=

# ---- Google Calendar (OAuth, per business) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# e.g. http://localhost:8000/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# ---- WhatsApp (OPEN DECISION: provider, see docs/DECISIONS.md) ----
# mock | (provider TBD)
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---- CRM ----
# true | false (default false). When false the CRM adapter is a no-op.
HUBSPOT_ENABLED=
HUBSPOT_ACCESS_TOKEN=

# ---- Limits and cost controls ----
# Hard cap on a single call's length, in seconds (e.g. 600)
CALL_MAX_SECONDS=
# Monthly minutes per business before calls go to the callback fallback (e.g. 500)
DEFAULT_BUSINESS_USAGE_CAP_MINUTES=
